@model SmartCollegeMS.Models.ViewModels.AttendanceViewModel

@{
    ViewData["Title"] = "Mark Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-primary fw-bold m-0"><i class="bi bi-calendar-check"></i> Attendance Management</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body bg-light rounded">
        <form asp-action="Index" method="get" class="row align-items-center">
            <div class="col-md-4">
                <label class="fw-bold">Select Date:</label>
                <input type="date" name="date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-4 mt-4">
                <button type="submit" class="btn btn-primary fw-bold">Load Attendance</button>
            </div>
        </form>
    </div>
</div>

<form asp-action="Save" method="post">
    <input type="hidden" asp-for="Date" />
    
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="bg-primary text-white">
                    <tr>
                        <th class="py-3 px-4">Student ID</th>
                        <th class="py-3">Name</th>
                        <th class="py-3 text-center">Status (Check = Present)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Students.Count; i++)
                    {
                        <tr class="align-middle">
                            <input type="hidden" asp-for="Students[i].StudentId" />
                            <td class="px-4 fw-bold text-secondary">@Model.Students[i].StudentCode</td>
                            <td>@Model.Students[i].FullName</td>
                            <td class="text-center">
                                <div class="form-check form-switch d-inline-block fs-4">
                                    <input class="form-check-input" type="checkbox" asp-for="Students[i].IsPresent" />
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Students.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No students found in the database. Please add students first.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Students.Any())
        {
            <div class="card-footer bg-white text-end py-3">
                <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                    <i class="bi bi-save"></i> Save Attendance for @Model.Date.ToString("dd-MMM-yyyy")
                </button>
            </div>
        }
    </div>
</form>